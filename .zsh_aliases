# vim and tmux
alias v='nvim'
alias nv='nvim'
alias dot='(cd ~/dotfiles && nvim ~/dotfiles)'

# python3
alias python='python3'
alias pip='pip3'
# alias python=~/opt/miniconda3/bin/python

# shortcuts
alias c='clear'
alias b='cd ..'
alias x='exit'
alias ls='ls -G'
alias h='cd ~ && clear'
alias src='source ~/.zshrc'
alias pi='ssh raspberrypi.local -l pi'

# git
alias gs='git status'
alias gb="git branch | grep -v 'zz-'" # I prefix stale branches I want to keep with zz-
alias gdiff='git diff staging...HEAD'
alias gl='pretty_git_log'
alias gv='git diff --name-only | uniq | xargs nvim'
alias clean_up_all_branches='git branch | grep -v "staging" | grep -v "main" | grep -v "zz-" | xargs git branch -D'

# docker
alias dcd='docker compose down -v --remove-orphans'
alias dcbw='docker compose build web'

alias lorem='cat ~/dotfiles/placeholders/lorem.txt | pbcopy'
alias hipsum='cat ~/dotfiles/placeholders/hipsum.txt | pbcopy'

alias claudeconf='v ~/Library/Application\ Support/Claude/claude_desktop_config.json'

find_and_replace() {
  echo $1
  git grep -l $1
  echo $1
  git grep -l $1 | xargs sed -i '' -e "s/$1/$2/g"
}

alias ports='lsof -i -n -P | grep TCP'
